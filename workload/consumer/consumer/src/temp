    async fn safe_write_consumed(&self, b_as: Vec<(BankAccount, NaiveDateTime)>, kafka_mode: &KafkaConsumers) {
        // Instead of update, you should write the entire BankAccount to a new consumers table
        // then the validator should check if both bank accounts referenced by the same ids in the consumer and producer are the same
        // OR
        // Validator should look at the latest produced message and see that all prior messages were produced
        //

        let ids: Vec<i32> = b_as.iter().map(|(acc, _)| acc.id).collect();
        let timestamps: Vec<NaiveDateTime> = b_as.iter().map(|(_, ts)| *ts).collect();
        let consumer_type = kafka_mode.get_route();

        // Build the query
        let query = "
            UPDATE producer
            SET
                consumed_timestamp = data.consumed_timestamp,
                consumer_type = $1,
                consumed_count = consumed_count + 1
            FROM (
                SELECT UNNEST($2::INT[]) AS id,
                       UNNEST($3::TIMESTAMP[]) AS consumed_timestamp
            ) AS data
            WHERE producer.id = data.id;
        ";

        loop {
            let result = self.client.execute(query, &[&consumer_type, &ids, &timestamps]).await;
            match result {
                Ok(d) => {
                    if d > 0 {
                        println!("postgres: Updated fields: {:?}, rows updated: {}", &ids, &d);
                        assert_sometimes!(true, "Recorded data consumed from Kafka to state-tracker", &json!({"result": format!("{:?}", &ids)}));
                        break;
                    } else {
                        eprintln!("postgres: I guess we updated nothing...: {}", &d);
                        assert_unreachable!("Recorded 0 data consumed from Kafka to state-tracker with no errors", &json!({"result": "none"}));
                        sleep(Duration::from_secs(1)); // Avoid tight retry loop
                    }            
                },
                Err(e) => {
                    eprintln!("postgres: Failed to update fields: {:?} error: {}", &ids, e);
                    assert_sometimes!(false, "Recorded data consumed from Kafka to state-tracker", &json!({"error": format!("Failed to update timestamp {}", e)}));
                    sleep(Duration::from_secs(1)); // Avoid tight retry loop
                }
            }
        }
    }
